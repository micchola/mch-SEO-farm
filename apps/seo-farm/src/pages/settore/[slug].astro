---
// Pagina: /settore/[slug] — Software per settore
import Base from '../../layouts/base.astro';
import fs from 'fs';
import path from 'path';

export function getStaticPaths() {
  const dir = path.join(process.cwd(), 'content/settore');
  if (!fs.existsSync(dir)) return [];
  return fs.readdirSync(dir).filter(f => f.endsWith('.md')).map(f => ({
    params: { slug: f.replace('.md', '') },
  }));
}

const { slug } = Astro.params;
const md = fs.readFileSync(path.join(process.cwd(), `content/settore/${slug}.md`), 'utf-8');
const title = md.split('\n').find(l => l.startsWith('# '))?.replace('# ', '') || slug;
const body = md.replace(/^# .*\n/, '').trim();
---
<Base title={title} description={`I migliori software per ${slug} in Italia nel 2026. Confronto, prezzi, pros e contro.`} canonical={`https://mch-seo-farm.vercel.app/settore/${slug}`}>
  <article>
    <h1>{title}</h1>
    {body}
  </article>
</Base>
