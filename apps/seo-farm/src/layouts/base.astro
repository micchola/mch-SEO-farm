---
// Base layout per tutte le pagine MCH pSEO
const { title, description = '', canonical = '' } = Astro.props;
---
<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  {canonical && <link rel="canonical" href={canonical}>}
  <meta name="generator" content="MCH pSEO">
  <meta property="og:title" content={title}>
  {description && <meta property="og:description" content={description}>}
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, -apple-system, sans-serif; line-height: 1.6; color: #1a1a2e; }
    .container { max-width: 800px; margin: 0 auto; padding: 2rem 1rem; }
    article { font-size: 1.1rem; }
    h1 { font-size: 2rem; margin: 1rem 0; }
    h2 { font-size: 1.5rem; margin: 1.5rem 0 0.75rem; }
    h3 { font-size: 1.2rem; margin: 1rem 0 0.5rem; }
    p { margin: 0.75rem 0; }
    table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
    th, td { border: 1px solid #e0e0e0; padding: 0.5rem; text-align: left; }
    th { background: #f5f5f5; font-weight: 600; }
    .footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #e0e0e0; font-size: 0.85rem; color: #666; }
    .pro { color: #2e7d32; }
    .con { color: #c62828; }
    code { background: #f5f5f5; padding: 0.1rem 0.3rem; border-radius: 3px; font-size: 0.9em; }
  </style>
</head>
<body>
  <div class="container">
    <main>
      <slot />
    </main>
    <footer class="footer">
      <p>Contenuto generato con AI. Aggiornato al 2026. | <a href="/">Home</a></p>
      <p>© MCH pSEO — Tutti i diritti riservati.</p>
    </footer>
  </div>
</body>
</html>
